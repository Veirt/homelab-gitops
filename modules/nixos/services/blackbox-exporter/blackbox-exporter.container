[Unit]
Description=Prometheus Blackbox Exporter
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/prometheus/blackbox-exporter:v0.29.1
ContainerName=blackbox-exporter
@NETWORK@
@IP_ADDRESS@
@DNS_SERVER@
Exec=--config.file=/etc/blackbox_exporter/blackbox.yml --web.listen-address=@LISTEN_ADDRESS@
Volume=@CONFIG_FILE@:/etc/blackbox_exporter/blackbox.yml:ro
LogDriver=journald

[Service]
Slice=apps.slice
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
