[Unit]
Description=Grafana dashboards and data visualization
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/grafana

[Container]
Image=docker.io/grafana/grafana@sha256:2abd2114bb65e4d6f0614206b7c882c1e7c6a992827ba08396aa5afc23ca07f5
ContainerName=grafana
Environment=GF_PATHS_PROVISIONING=/etc/grafana/provisioning
Environment=GF_SERVER_DOMAIN=@SERVER_DOMAIN@
Environment=GF_SERVER_ROOT_URL=@ROOT_URL@
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
EnvironmentFile=/var/lib/grafana-admin.env
Volume=/var/lib/grafana:/var/lib/grafana
Volume=/etc/grafana/provisioning/datasources/homelab.yaml:/etc/grafana/provisioning/datasources/homelab.yaml:ro
Volume=/etc/grafana/provisioning/dashboards/homelab.yaml:/etc/grafana/provisioning/dashboards/homelab.yaml:ro
@DASHBOARD_VOLUME@
PublishPort=@LISTEN_ADDRESS@:3000:3000
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
