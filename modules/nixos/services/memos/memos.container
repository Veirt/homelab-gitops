[Unit]
Description=Memos notes service
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/memos

[Container]
Image=docker.io/neosmemo/memos:0.31.0
ContainerName=memos
Volume=/var/lib/memos:/var/opt/memos
PublishPort=@LISTEN_ADDRESS@:15230:5230
Pull=newer
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
