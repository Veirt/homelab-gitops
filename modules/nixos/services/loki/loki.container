[Unit]
Description=Loki log aggregation
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/loki

[Container]
Image=docker.io/grafana/loki:3.7.8
ContainerName=loki
Exec=-config.file=/etc/loki/config.yaml
Volume=/var/lib/loki:/loki
Volume=/etc/loki/config.yaml:/etc/loki/config.yaml:ro
PublishPort=@LISTEN_ADDRESS@:3100:3100
LogDriver=journald

[Service]
Slice=apps.slice
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
