[Unit]
Description=Loki log aggregation
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/loki

[Container]
Image=docker.io/grafana/loki@sha256:0db216b630ae1f348a1584c67f3cead8b4c1fc839169a39501db664744158e28
ContainerName=loki
Exec=-config.file=/etc/loki/config.yaml
Volume=/var/lib/loki:/loki
Volume=/etc/loki/config.yaml:/etc/loki/config.yaml:ro
PublishPort=@LISTEN_ADDRESS@:3100:3100
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
