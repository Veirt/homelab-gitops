[Unit]
Description=Vaultwarden password manager
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/vaultwarden

[Container]
Image=docker.io/vaultwarden/server:1.37.5
User=1000:1000
ContainerName=vaultwarden
Environment=DOMAIN=@DOMAIN@
# uid 1000 cannot bind ports <1024 inside the container (rootful podman does
# not lower ip_unprivileged_port_start for --user), so serve on an
# unprivileged port and publish 8222 -> 8080.
Environment=ROCKET_PORT=8080
Volume=/var/lib/vaultwarden:/data:U
PublishPort=@LISTEN_ADDRESS@:8222:8080
LogDriver=journald

[Service]
Slice=apps.slice
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
