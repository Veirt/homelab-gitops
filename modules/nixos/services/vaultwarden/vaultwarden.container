[Unit]
Description=Vaultwarden password manager
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/vaultwarden

[Container]
Image=docker.io/vaultwarden/server@sha256:4fe17f415f90087377d37c755e0ea3cf189dcc6794e49cdd2a9adbb4937d9e1f
ContainerName=vaultwarden
Environment=DOMAIN=@DOMAIN@
Environment=ROCKET_PORT=80
Volume=/var/lib/vaultwarden:/data
PublishPort=@LISTEN_ADDRESS@:8222:80
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
