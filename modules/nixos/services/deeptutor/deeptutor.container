[Unit]
Description=DeepTutor learning workspace
Documentation=https://github.com/HKUDS/DeepTutor
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/deeptutor/data

[Container]
Image=ghcr.io/hkuds/deeptutor:1.7.2
ContainerName=deeptutor
Volume=/var/lib/deeptutor/data:/app/data
Volume=/var/lib/deeptutor/data/user/workspace:/workspace
Environment=TZ=UTC
Environment=DEEPTUTOR_WORKSPACE_ROOT=/workspace
Environment=DEEPTUTOR_WORKSPACE_ALLOWED_ROOTS=/workspace
ReadOnly=true
Tmpfs=/tmp:size=512m,mode=1777
Tmpfs=/run:size=32m,mode=0755
Tmpfs=/var/run:size=8m,mode=0755
Tmpfs=/var/log:size=64m,mode=0755
Tmpfs=/root:size=16m,mode=0700
Tmpfs=/home:size=16m,mode=0755
PublishPort=@LISTEN_ADDRESS@:3782:3782
HealthCmd=curl -fsS http://localhost:8001/health/ready
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
Pull=newer
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
