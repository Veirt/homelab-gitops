[Unit]
Description=VictoriaMetrics single-node time-series database
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/victoria-metrics

[Container]
Image=docker.io/victoriametrics/victoria-metrics:v1.154.0
ContainerName=victoria-metrics
@NETWORK@
Exec=@EXEC_ARGS@
@SCRAPE_CONFIG_VOLUME@
Volume=/var/lib/victoria-metrics:/victoria-metrics-data
PublishPort=@LISTEN_ADDRESS@:8428:8428
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
